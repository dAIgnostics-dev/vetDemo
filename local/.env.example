# Lokalni backend konfiguracija (kopiraj u local/.env i prilagodi po potrebi)

# HTTP port backenda
PORT=8000

# LLM backend: "ollama" (lokalno, default) ili "bedrock" (legacy AWS)
LLM_BACKEND=ollama

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=120

# SQLite datoteka (default: local/vetdemo.db)
# DB_PATH=/apsolutna/putanja/vetdemo.db
